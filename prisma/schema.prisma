generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum PromptIntent {
  LOCAL_DISCOVERY
  BEST_OF
  COMPARISON
  CATEGORY
  TRUST
  SOLUTION_SELECTION
}

enum PromptSource {
  GENERATED
  CUSTOM
  IMPORTED
}

enum PromptStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EngineMode {
  MOCK
  LIVE
}

enum PromptRunStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MentionType {
  TARGET
  COMPETITOR
  THIRD_PARTY
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationEffort {
  QUICK_WIN
  MEDIUM
  STRATEGIC
}

enum RecommendationStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum RecommendationType {
  ENTITY_CLARITY
  LOCAL_PAGES
  FAQ_CONTENT
  COMPARISON_CONTENT
  TRUST_AUTHORITY
  SOURCE_PRESENCE
  CONSISTENCY_FIX
}

enum ReportStatus {
  DRAFT
  GENERATED
  ARCHIVED
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String            @unique
  passwordHash       String
  defaultWorkspaceId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  memberships        WorkspaceMember[]
  defaultWorkspace   Workspace?        @relation("DefaultWorkspace", fields: [defaultWorkspaceId], references: [id])
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  members         WorkspaceMember[]
  defaultForUsers User[]            @relation("DefaultWorkspace")
  businesses      Business[]
  claimedAudits   VisibilityAudit[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Business {
  id                String               @id @default(cuid())
  workspaceId       String
  name              String
  slug              String               @unique
  websiteDomain     String
  industry          String
  category          String
  description       String
  australianStates  String[]
  targetLocations   String[]
  productsServices  String[]
  customerKeywords  String[]
  onboardingDone    Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  competitors       Competitor[]
  prompts           Prompt[]
  promptRuns        PromptRun[]
  recommendations   Recommendation[]
  snapshots         VisibilitySnapshot[]
  reports           Report[]
}

model Competitor {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  websiteDomain   String?
  description     String?
  locationsServed String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PromptCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  sortOrder   Int     @default(0)
  prompts     Prompt[]
}

model Prompt {
  id         String       @id @default(cuid())
  businessId String
  categoryId String
  text       String
  intent     PromptIntent
  source     PromptSource @default(GENERATED)
  status     PromptStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   PromptCategory @relation(fields: [categoryId], references: [id])
  promptRuns PromptRun[]
}

model Engine {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  provider   String
  mode       EngineMode  @default(MOCK)
  isActive   Boolean     @default(true)
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  promptRuns PromptRun[]
}

model PromptRun {
  id                 String          @id @default(cuid())
  businessId         String
  promptId           String
  engineId           String
  status             PromptRunStatus @default(PENDING)
  rawAnswer          String?
  answerTone         String?
  userAppeared       Boolean         @default(false)
  competitorAppeared Boolean         @default(false)
  rankPosition       Int?
  engineMetadata     Json?
  requestedAt        DateTime        @default(now())
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  prompt             Prompt          @relation(fields: [promptId], references: [id], onDelete: Cascade)
  engine             Engine          @relation(fields: [engineId], references: [id])
  result             PromptResult?
}

model PromptResult {
  id              String       @id @default(cuid())
  promptRunId     String       @unique
  summary         String
  sentimentLabel  String
  confidenceScore Float?
  analysisVersion String       @default("mvp-v1")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  promptRun       PromptRun    @relation(fields: [promptRunId], references: [id], onDelete: Cascade)
  mentions        Mention[]
  citationSources CitationSource[]
}

model Mention {
  id             String       @id @default(cuid())
  promptResultId String
  name           String
  domain         String?
  mentionType    MentionType
  rank           Int?
  sentiment      String?
  createdAt      DateTime     @default(now())
  promptResult   PromptResult @relation(fields: [promptResultId], references: [id], onDelete: Cascade)
}

model CitationSource {
  id             String       @id @default(cuid())
  promptResultId String
  domain         String
  url            String?
  title          String?
  createdAt      DateTime     @default(now())
  promptResult   PromptResult @relation(fields: [promptResultId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id          String               @id @default(cuid())
  businessId  String
  title       String
  description String
  priority    RecommendationPriority
  effort      RecommendationEffort
  type        RecommendationType
  rationale   String
  status      RecommendationStatus @default(OPEN)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model VisibilitySnapshot {
  id                 String   @id @default(cuid())
  businessId         String
  visibilityScore    Float
  competitorGapScore Float
  opportunityScore   Float
  promptCoverage     Float
  citationCoverage   Float
  winRate            Float
  shareOfVisibility  Float
  createdAt          DateTime @default(now())
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Report {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  summary     String
  periodStart DateTime
  periodEnd   DateTime
  status      ReportStatus @default(GENERATED)
  generatedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model VisibilityAudit {
  id                  String                  @id @default(cuid())
  shareToken          String                  @unique
  status              String                  @default("created")
  email               String?
  websiteUrl          String
  websiteDomain       String
  inferredProfileJson Json?
  editedProfileJson   Json?
  promptPlanJson      Json?
  reportJson          Json?
  claimedWorkspaceId  String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  claimedWorkspace    Workspace?              @relation(fields: [claimedWorkspaceId], references: [id], onDelete: SetNull)
  results             VisibilityAuditResult[]

  @@index([status])
  @@index([claimedWorkspaceId])
}

model VisibilityAuditResult {
  id                           String          @id @default(cuid())
  auditId                      String
  prompt                       String
  promptCategory               String
  engine                       String
  model                        String
  rawAnswer                    String?
  answerExcerpt                String?
  targetMentioned              Boolean?
  targetRecommended            Boolean?
  rankPosition                 Int?
  competitorsMentionedJson     Json?
  competitorsRecommendedJson   Json?
  sourcesJson                  Json?
  sourceStatus                 String
  sentiment                    String?
  confidence                   Float?
  error                        String?
  latencyMs                    Int?
  createdAt                    DateTime        @default(now())
  audit                        VisibilityAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([engine])
  @@index([promptCategory])
}
